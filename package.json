{
  "name": "centuris-capital-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs && tailwindcss -i src/styles.css -o dist/assets/site.css --minify",
    "dev": "node build.mjs && tailwindcss -i src/styles.css -o dist/assets/site.css --watch",
    "serve": "python3 -m http.server 4321 -d dist"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.3.4"
  }
}
